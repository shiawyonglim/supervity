# ===================================================================
#      AUTOPILOT COMMAND CENTER - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env to get started.
#  Defaults work out of the box — just run: make up
# ===================================================================

# ------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=INFO

# Auth bypass — all requests auto-authenticated as Dev User (admin role)
AUTH_BYPASS=true

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BASE_PATH=

# NextAuth (required for session management even with AUTH_BYPASS)
NEXTAUTH_URL=http://localhost:3001

# REQUIRED: A secret used to sign and encrypt NextAuth.js tokens.
# Generate with:
#   macOS/Linux: openssl rand -base64 32
#   Windows:     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))


# ------------------------------------------------------------
# SUPERIVITY AUTO WORKFLOW (optional)
# ------------------------------------------------------------
# Set to trigger the Master Orchestrator when drafting emails.
# WORKFLOW_API_KEY=<your-api-key>
# SUPERVITY_WORKFLOW_ID=019fd5dd-4f56-7000-8641-9bfdd6c1e3e1


# ------------------------------------------------------------
# OUTLOOK SMTP / IMAP (optional)
# ------------------------------------------------------------
# For real email delivery and inbox listening. Use an app password
# or OAuth token depending on your Microsoft 365 tenant.
# OUTLOOK_EMAIL=supervity@example.com
# OUTLOOK_SMTP_USER=supervity@example.com
# OUTLOOK_SMTP_PASSWORD=<app-password>
# OUTLOOK_IMAP_USER=supervity@example.com
# OUTLOOK_IMAP_PASSWORD=<app-password>


# ------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------
# "dev" = hot reload | "prod" = optimized build
FRONTEND_TARGET=dev

